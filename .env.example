# ─────────────────────────────────────────────
# NovaNest Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# NeonDB — PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_lzSPDK9uHA2x@ep-polished-tree-axxtf7q9-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email (Nodemailer — e.g. Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="NovaNest <your_email@gmail.com>"
COMPANY_EMAIL=inquiries@novanest.lk

# Frontend URLs (for CORS)
WEBSITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
